{
  "name": "@kakoyo/dsh-kakoyo",
  "version": "0.2.0",
  "description": "@kakoyo DeepSeek Harness settings card: shows the Kakoyo plugin roster in Settings → Plugins → Plugin config list (standalone; no bundled dependencies)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "keywords": ["dsh-plugin", "deepseek-harness", "kakoyo", "settings"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
