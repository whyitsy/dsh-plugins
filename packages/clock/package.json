{
  "name": "@kakoyo/dsh-clock",
  "version": "0.1.0",
  "description": "A current date+time clock (to the second) in the composer tool row, for the DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "keywords": ["dsh-plugin", "deepseek-harness", "clock", "kakoyo"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
